# IdeaPilot — configuration. Copier en .env.local (jamais commité) et, pour la production,
# renseigner les mêmes variables dans Vercel > Project > Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---------------------------------------------------
# URL du projet.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé PUBLIQUE « publishable » (sb_publishable_…). Elle est visible dans le navigateur :
# la protection des données repose sur la connexion (Supabase Auth) et les politiques RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Compatibilité : si votre projet n'expose que l'ancienne clé « anon » (JWT), laissez la ligne
# précédente vide et renseignez celle-ci. Elle n'est lue que si la clé publishable est absente.
# VITE_SUPABASE_ANON_KEY=

# INTERDIT : ne jamais mettre la clé service_role / sb_secret_… dans une variable VITE_
# (l'application refuse d'ailleurs de démarrer avec une clé secrète).

# --- Fournisseur de notation IA -----------------------------------------------------------
# "mock" (défaut) : simulation déterministe. Un vrai modèle passera par une fonction serveur
# qui détient la clé (ANTHROPIC_API_KEY côté serveur, jamais préfixée VITE_) : voir plus bas.
VITE_AI_PROVIDER=mock

# --- Futur fournisseur IA réel (inactif en V1) ---------------------------------------------
# Côté navigateur : passer VITE_AI_PROVIDER=http pour appeler la fonction serveur /api/score.
# Côté SERVEUR uniquement (Vercel > Environment Variables, JAMAIS préfixées VITE_) :
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Tant que ANTHROPIC_API_KEY est absente, /api/score répond 503 « not_configured ».
